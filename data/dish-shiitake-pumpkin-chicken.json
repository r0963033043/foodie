      { "name": "Rice wine", "amount": 1, "unit": "tsp" },
      { "name": "Potato starch", "amount": 1, "unit": "tbsp" }
    ],
    "steps": [
      {
        "phase": "Preparatory work",
        "items": [
          "Soak the dried shiitake until soft, then slice. Peel the pumpkin and cut into chunks; shred the ginger and chop the celery.",
          "Slice the chicken breast and marinate it with all of the seasonings and the potato starch."
        ]
      },
      {
        "phase": "Start cook",
        "items": [
          "Layer the pumpkin in the bottom of a heatproof dish, then top with the marinated chicken and shiitake.",
          "Add 1.5 cups of water to the rice cooker's outer pot and steam until the switch pops up (about 20 minutes).",
          "Sprinkle with the celery and fried shallots, toss gently, and serve."
        ]
      }
    ]
