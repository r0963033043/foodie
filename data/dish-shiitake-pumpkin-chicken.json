          { "name": "Ginger", "amount": 4, "unit": "g" },
          { "name": "Celery", "text": "to taste" }
        ]
      }
    ],
    "sauce": [
      { "name": "Soy paste", "amount": 1, "unit": "tbsp" },
      { "name": "Soy sauce", "amount": 1, "unit": "tsp" },
      { "name": "Black vinegar", "amount": 1, "unit": "tsp" },
      { "name": "White pepper", "amount": 0.33, "unit": "tsp" },
      { "name": "White sesame oil", "amount": 1, "unit": "tsp" },
      { "name": "Fried shallots", "amount": 1, "unit": "tbsp" },
