          { "name": "Beef tomato", "amount": 250, "unit": "g" },
          { "name": "Chinese yam", "amount": 150, "unit": "g" },
          { "name": "Onion", "amount": 0.5, "unit": "pcs" },
          { "name": "Fish fillet, sliced", "amount": 200, "unit": "g" },
          { "name": "Tofu skin", "amount": 50, "unit": "g" },
          { "name": "Clams", "amount": 300, "unit": "g" },
          { "name": "Water", "amount": 1000, "unit": "ml" }
        ]
      }
    ],
    "sauce": [
      { "name": "Salt", "amount": 1, "unit": "tsp" },
      { "name": "Mirin", "amount": 1, "unit": "tsp" },
      { "name": "White pepper", "amount": 0.33, "unit": "tsp" },
      { "name": "Black pepper", "amount": 0.25, "unit": "tsp" },
      { "name": "Celery", "text": "to taste" },
      { "name": "Chopped scallion", "text": "to taste" }
    ],
    "steps": [
      {
        "phase": "Preparatory work",
        "items": [
          "Cut the tomatoes into wedges, peel and dice the yam, slice the onion, and cut the tofu skin into strips.",
          "Soak the clams in salted water to purge any sand."
        ]
      },
      {
        "phase": "Start cook",
        "items": [
          "Combine the tomato, yam, onion, tofu skin and water in the inner pot. Add 1.5 cups of water to the outer pot and steam until the switch pops up.",
          "Add the fish slices and clams, season with salt, mirin and the peppers, then steam again until the clams open and the fish is cooked through.",
          "Garnish with celery and scallion, and serve hot."
        ]
      }
    ]
  },
